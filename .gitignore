# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output & cache
/.next/
/out/
/build
/dist
.turbo

# Environment variables (keep .env.example if present)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Debug and package manager logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel deployment metadata
.vercel

# Testing & Coverage
/coverage

# TypeScript build info
*.tsbuildinfo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor settings
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Temporary files
*.tmp
*.temp
